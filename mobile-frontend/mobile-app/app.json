{
  "expo": {
    "name": "Langue",
    "slug": "Langue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/langue-logo-3.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/langue-logo-3.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/langue-logo-3.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ccarson1.Langue"
    },
    "web": {
      "favicon": "./assets/langue-logo-3.png"
    },
    "extra": {
      "eas": {
        "projectId": "1b4b5981-541a-4a79-b52e-1f1c50bef5af"
      }
    },
    "plugins": [
      "expo-font",
      "expo-video"
    ]
  }
}
